{
  "name": "serverest-cypress",
  "version": "1.0.0",
  "private": true,
  "description": "Automação Cypress do ServeRest com Page Object, contratos da API e relatório Allure.",
  "scripts": {
    "cy:open": "cypress open",
    "test:frontend": "cypress run --browser chrome --spec \"cypress/e2e/frontend/**/*.cy.ts\"",
    "test:api": "cypress run --browser chrome --spec \"cypress/e2e/api/**/*.cy.ts\"",
    "test:e2e": "cypress run --browser chrome",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "test": "npm run test:e2e && npm run allure:generate",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.6.0",
    "@types/node": "^26.6.5",
    "allure-commandline": "^2.46.1",
    "allure-cypress": "^3.14.0",
    "allure-js-commons": "^3.14.0",
    "cypress": "^16.2.0",
    "typescript": "^7.0.2",
    "zod": "^4.6.7"
  }
}
